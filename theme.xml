  <!-- ============================================== main window ======= -->
  <Window id="main" position="Center" dragdrop="true" playondrop="true">

    <!-- ................................................ full layout ... -->
    <Layout id="normal" width="800" height="520"
            minwidth="700" maxwidth="99999" minheight="340" maxheight="99999">

      <!-- ...................................... header .............. -->
      <Panel id="n.head" x="0" y="0" width="800" height="36"
             lefttop="lefttop" rightbottom="righttop">
        <Image id="n.head.bg" x="0" y="0" width="800" height="36" image="bg_header"
               resize="mosaic" lefttop="lefttop" rightbottom="righttop"
               action="move" action2="dialogs.popup()"/>

        <Image id="n.led.g0" x="14" y="11" image="led_g_off"/>
        <Image id="n.led.g1" x="14" y="11" image="led_g_on"  visible="vlc.isPlaying"/>
        <Image id="n.led.r0" x="32" y="11" image="led_r_off"/>
        <Image id="n.led.r1" x="32" y="11" image="led_r_on"
               visible="vlc.isPaused or vlc.isRecording"/>
        <Image id="n.badge"  x="56" y="9"  image="badge"
               action="move" action2="dialogs.popup()"/>

        <Checkbox id="n.eq" x="636" y="5" state="equalizer.isEnabled"
                  up1="chk_eq_off_up" over1="chk_eq_off_over" down1="chk_eq_off_down"
                  up2="chk_eq_on_up"  over2="chk_eq_on_over"  down2="chk_eq_on_down"
                  action1="equalizer.enable(); eqwin.show()"
                  action2="eqwin.show()"
                  tooltiptext1="Enable the equalizer" tooltiptext2="Equalizer"
                  lefttop="righttop" rightbottom="righttop"/>
        <Button id="n.shade" x="666" y="5" up="sys_shade_up" over="sys_shade_over"
                down="sys_shade_down" action="main.setLayout(compact)"
                tooltiptext="Collapse to the control bar"
                lefttop="righttop" rightbottom="righttop"/>
        <Button id="n.min" x="696" y="5" up="sys_min_up" over="sys_min_over"
                down="sys_min_down" action="vlc.minimize()" tooltiptext="Minimise"
                lefttop="righttop" rightbottom="righttop"/>
        <Button id="n.max" x="726" y="5" up="sys_max_up" over="sys_max_over"
                down="sys_max_down" action="main.maximize()" tooltiptext="Maximise"
                visible="not main.isMaximized"
                lefttop="righttop" rightbottom="righttop"/>
        <Button id="n.unmax" x="726" y="5" up="sys_unmax_up" over="sys_unmax_over"
                down="sys_unmax_down" action="main.unmaximize()" tooltiptext="Restore"
                visible="main.isMaximized"
                lefttop="righttop" rightbottom="righttop"/>
        <Button id="n.close" x="756" y="5" up="sys_close_up" over="sys_close_over"
                down="sys_close_down" action="vlc.quit()" tooltiptext="Quit VLC"
                lefttop="righttop" rightbottom="righttop"/>
      </Panel>

      <!-- ...................................... stage ............... -->
      <Panel id="n.stage" x="0" y="36" width="800" height="356"
             lefttop="lefttop" rightbottom="rightbottom">
        <Image id="n.stage.bg" x="0" y="0" width="800" height="356" image="bg_stage"
               resize="mosaic" lefttop="lefttop" rightbottom="rightbottom"
               action="move" action2="dialogs.popup()"/>
        <!-- scale2 centres the cover art and keeps its aspect; the box is
             inset from the stage and shrinks with it, so it can never spill. -->
        <Image id="n.stage.art" x="60" y="30" width="680" height="296"
               image="bg_stage" art="true" resize="scale2"
               lefttop="lefttop" rightbottom="rightbottom"
               visible="not vlc.hasVout and not vlc.isStopped"/>
        <Image id="n.stage.mark" x="170" y="114" image="stage_mark"
               xkeepratio="true" ykeepratio="true" visible="vlc.isStopped"
               action="dialogs.fileSimple()" action2="dialogs.popup()"/>
        <Video id="n.video" x="0" y="0" width="800" height="356" autoresize="true"
               lefttop="lefttop" rightbottom="rightbottom" visible="vlc.hasVout"/>
      </Panel>

      <!-- ...................................... deck ................ -->
      <Panel id="n.deck" x="0" y="392" width="800" height="128"
             lefttop="leftbottom" rightbottom="rightbottom">
        <Image id="n.deck.bg" x="0" y="0" width="800" height="128" image="bg_deck"
               resize="mosaic" lefttop="lefttop" rightbottom="righttop"
               action="move" action2="dialogs.popup()"/>
        <Image id="n.deck.lcd" x="0" y="5" width="800" height="44" image="bg_lcd"
               resize="mosaic" lefttop="lefttop" rightbottom="righttop"
               action="move" action2="dialogs.popup()"/>

        <Text id="n.lcd.time" x="16" y="7" width="240" font="lcd_sm"
              color="#807D05" text="$t / $d" alignment="left" focus="false"/>
        <Text id="n.lcd.meta" x="544" y="7" width="240" font="lcd_sm"
              color="#807D05" text="VOL $V%   RATE x$R" alignment="right"
              focus="false" lefttop="righttop" rightbottom="righttop"/>
        <Text id="n.lcd.name" x="16" y="23" width="768" font="lcd_lg"
              color="#141508" text="$N" scrolling="auto" alignment="left"
              rightbottom="righttop" visible="not vlc.isStopped"/>
        <Text id="n.lcd.idle" x="16" y="23" width="768" font="lcd_lg"
              color="#141508" text="HACK THE PLANET" alignment="left"
              focus="false" rightbottom="righttop" visible="vlc.isStopped"/>

        <Slider id="n.seek" x="18" y="58" width="764" height="6"
                points="(0,3),(764,3)" value="time" thickness="18"
                up="seek_thumb_up" over="seek_thumb_over" down="seek_thumb_down"
                tooltiptext="$t / $d" rightbottom="righttop">
          <SliderBackground id="n.seek.bg" image="seek_fill" nbvert="61"/>
        </Slider>

        <Button id="n.open" x="18" y="82" up="pad_open_up" over="pad_open_over"
                down="pad_open_down" action="dialogs.file()"
                tooltiptext="Open media"/>
        <Checkbox id="n.list" x="56" y="82" state="plwin.isVisible"
                  up1="pad_list_up" over1="pad_list_over" down1="pad_list_down"
                  up2="pad_list_on_up" over2="pad_list_on_over" down2="pad_list_on_down"
                  action1="plwin.show()" action2="plwin.hide()"
                  tooltiptext1="Show the playlist" tooltiptext2="Hide the playlist"/>
        <Button id="n.snap" x="94" y="85" up="ico_snap_up" over="ico_snap_over"
                down="ico_snap_down" action="vlc.snapshot()"
                tooltiptext="Snapshot" visible="vlc.hasVout"/>

        <!-- The nav rocker travels as one piece: xkeepratio on the panel
             keeps it centred, while the five faces stay rigid inside it. -->
        <Panel id="n.nav" x="312" y="76" width="176" height="44" xkeepratio="true">
          <Button id="n.prev" x="0" y="0" up="tr_prev_up" over="tr_prev_over"
                  down="tr_prev_down" action="playlist.previous()"
                  tooltiptext="Previous"/>
          <Button id="n.play" x="50" y="0" up="tr_play_up" over="tr_play_over"
                  down="tr_play_down" action="vlc.play()" tooltiptext="Play"
                  visible="not vlc.isPlaying"/>
          <Button id="n.pause" x="50" y="0" up="tr_pause_up" over="tr_pause_over"
                  down="tr_pause_down" action="vlc.pause()" tooltiptext="Pause"
                  visible="vlc.isPlaying"/>
          <Button id="n.stop" x="50" y="23" up="tr_stop_up" over="tr_stop_over"
                  down="tr_stop_down" action="vlc.stop()" tooltiptext="Stop"/>
          <Button id="n.next" x="130" y="0" up="tr_next_up" over="tr_next_over"
                  down="tr_next_down" action="playlist.next()"
                  tooltiptext="Next"/>
        </Panel>

