        <SliderBackground id="f.seek.bg" image="seek_fill" nbvert="61"/>
      </Slider>

      <Text id="f.time" x="16" y="36" width="150" font="lcd_sm" color="#121208"
            text="$t / $d" alignment="left" focus="false"/>

      <Panel id="f.nav" x="299" y="32" width="122" height="26" xkeepratio="true">
        <Button id="f.prev" x="0" y="0" up="ico_prev_up" over="ico_prev_over"
                down="ico_prev_down" action="playlist.previous()"
                tooltiptext="Previous"/>
        <Button id="f.play" x="32" y="0" up="ico_play_up" over="ico_play_over"
                down="ico_play_down" action="vlc.play()" tooltiptext="Play"
                visible="not vlc.isPlaying"/>
        <Button id="f.pause" x="32" y="0" up="ico_pause_up" over="ico_pause_over"
                down="ico_pause_down" action="vlc.pause()" tooltiptext="Pause"
                visible="vlc.isPlaying"/>
        <Button id="f.stop" x="64" y="0" up="ico_stop_up" over="ico_stop_over"
                down="ico_stop_down" action="vlc.stop()" tooltiptext="Stop"/>
        <Button id="f.next" x="96" y="0" up="ico_next_up" over="ico_next_over"
                down="ico_next_down" action="playlist.next()" tooltiptext="Next"/>
      </Panel>

      <Checkbox id="f.mute" x="548" y="32" state="vlc.isMute"
                up1="chk_sound_on_up"  over1="chk_sound_on_over"  down1="chk_sound_on_down"
                up2="chk_sound_off_up" over2="chk_sound_off_over" down2="chk_sound_off_down"
                action1="vlc.mute()" action2="vlc.mute()"
                tooltiptext1="Mute" tooltiptext2="Unmute"
                lefttop="righttop" rightbottom="righttop"/>
      <Slider id="f.vol" x="580" y="42" width="84" height="6"
              points="(5,3),(79,3)" value="volume" thickness="16"
              up="vol_thumb_up" over="vol_thumb_over" down="vol_thumb_down"
              tooltiptext="Volume $V%"
              lefttop="righttop" rightbottom="righttop">
        <SliderBackground id="f.vol.bg" image="vol_fill" nbvert="21"/>
      </Slider>
      <Button id="f.full" x="678" y="32" up="ico_full_up" over="ico_full_over"
              down="ico_full_down" action="vlc.fullscreen()"
              tooltiptext="Leave fullscreen"
              lefttop="righttop" rightbottom="righttop"/>
    </Layout>
  </Window>

</Theme>
