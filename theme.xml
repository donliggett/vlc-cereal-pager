<!--
  Cereal Pager - a VLC skins2 theme.

  A retro-modern reading of the yellow Motorola Advisor pager from Hackers
  (1995).  Flat #EDE600 chassis, a two-line LCD readout, a dark nav rocker,
  and nothing at all to the left or right of the picture.

  Geometry notes (all sizes in px, at the default 800x520 main window):

      header   y   0 ..  36    LEDs, badge, window buttons - draggable
      stage    y  36 .. 392    full-bleed video / art / watermark
      deck     y 392 .. 520    LCD, seek, transport

    deck-local:
       0          1px rule
       5 ..  49   LCD readout   (line 1 at y 11, line 2 at y 26)
      58 ..  64   seek bar
      74 .. 122   control row   (everything vertically centred on y 98)

  Artwork in assets/ is generated - see tools/generate_assets.py.
  The <Bitmap> block below is generated too - see tools/sync_bitmaps.py.
-->
<Theme version="2.0" tooltipfont="ui" magnet="14" alpha="255" movealpha="224">

  <ThemeInfo name="Cereal Pager"
             author="Don Liggett"
             webpage="https://github.com/donliggett/vlc-cereal-pager"/>

